+         dst_a(k) = src_a(i)
+         dst_i(k) = src_i(i)
+         i = i + 1
+         k = k + 1
+      END DO
+      DO WHILE (j <= hi)
+         dst_a(k) = src_a(j)
+         dst_i(k) = src_i(j)
+         j = j + 1
+         k = k + 1
+      END DO
